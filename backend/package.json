{
  "name": "football-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Football Predictor backend: Express + PostgreSQL + prediction engine + cron",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/db/init.js",
    "predict:run": "node src/jobs/generatePredictions.js",
    "results:sync": "node src/jobs/syncResults.js",
    "backfill": "node src/jobs/backfill.js",
    "test": "node tests/engine.smoke.mjs"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1"
  }
}

